/* Global Reset and Base Styling */
QMainWindow {
    background-color: #09090b; /* Zinc 950 */
}

QWidget#CentralWidget {
    background-color: #09090b;
}

QWidget#PagesContainer {
    background-color: #09090b;
}

QWidget {
    color: #e4e4e7; /* Zinc 200 */
    font-family: "Inter", "Segoe UI", "Roboto", sans-serif;
    font-size: 14px;
}

QLabel {
    background-color: transparent;
}

/* Sidebar Styles */
QListWidget#Sidebar {
    background-color: #18181b; /* Zinc 900 */
    border-right: 1px solid #27272a; /* Zinc 800 */
    outline: none;
    padding-top: 10px;
}

QListWidget#Sidebar::item {
    border-radius: 12px;
    margin: 4px 10px;
    color: #a1a1aa; /* Zinc 400 */
    font-weight: 500;
}

QListWidget#Sidebar::item:hover {
    background-color: #27272a; /* Zinc 800 */
    color: #f4f4f5; /* Zinc 100 */
}

QListWidget#Sidebar::item:selected {
    background-color: #2563eb; /* Blue 600 */
    color: #ffffff;
    font-weight: 600;
}

/* ScrollBars */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #3f3f46; /* Zinc 700 */
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #52525b; /* Zinc 600 */
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Card Styling for Dashboard */
QFrame#Card {
    background-color: #18181b; /* Zinc 900 */
    border: 1px solid #27272a; /* Zinc 800 */
    border-radius: 16px;
    padding: 24px;
}

QLabel#Header {
    font-size: 28px;
    font-weight: 700;
    color: #fafafa;
    margin-bottom: 12px;
}

QLabel#CardTitle {
    font-size: 18px;
    font-weight: 600;
    color: #f4f4f5;
    margin-bottom: 16px;
    background-color: transparent;
}

QLabel#CardSubtitle {
    font-size: 13px;
    font-weight: 500;
    color: #a1a1aa;
    background-color: transparent;
    margin-bottom: 8px;
}

QLabel#LabelKey {
    color: #a1a1aa;
    font-weight: 500;
    background-color: transparent;
    font-size: 13px;
}

QLabel#LabelValue {
    color: #f4f4f5;
    font-weight: 600;
    background-color: transparent;
    font-size: 15px;
}

/* Stat Pill */
QFrame#StatPill {
    background-color: #18181b;
    border: 1px solid #27272a;
    border-radius: 14px;
    padding: 16px;
}

QFrame#StatPill:hover {
    border: 1px solid #3f3f46;
    background-color: #27272a;
}

/* Buttons */
QPushButton {
    background-color: #18181b;
    color: #e4e4e7;
    border: 1px solid #27272a;
    border-radius: 10px;
    padding: 10px 16px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #27272a;
    border: 1px solid #3f3f46;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #09090b;
}

/* Primary Button */
QPushButton#PrimaryBtn {
    background-color: #2563eb;
    color: white;
    border: none;
}

QPushButton#PrimaryBtn:hover {
    background-color: #3b82f6;
}

/* Text Edit / Terminal */
QTextEdit#Terminal {
    background-color: #020617; /* Slate 950 */
    color: #10b981; /* Emerald 500 */
    font-family: "Consolas", "Courier New", monospace;
    font-size: 13px;
    border: 1px solid #1e293b;
    border-radius: 12px;
    padding: 14px;
}

/* Chat Page Styling */
QTextEdit {
    background-color: #18181b;
    border: 1px solid #27272a;
    border-radius: 14px;
    padding: 18px;
    font-size: 15px;
    line-height: 1.6;
}

QLineEdit {
    background-color: #18181b;
    border: 1px solid #27272a;
    border-radius: 14px;
    padding: 14px 18px;
    color: #f4f4f5;
    font-size: 15px;
}

QLineEdit:focus {
    border: 1px solid #3b82f6;
    background-color: #09090b;
}

QPushButton#SendBtn {
    background-color: #2563eb;
    color: white;
    font-weight: bold;
    border: none;
    border-radius: 14px;
    padding: 14px 24px;
}

QPushButton#SendBtn:hover {
    background-color: #3b82f6;
}

QPushButton#SendBtn:pressed {
    background-color: #1d4ed8;
}

QGroupBox {
    border: 1px solid #27272a;
    border-radius: 12px;
    margin-top: 28px;
    font-weight: 600;
    color: #a1a1aa;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    padding: 0 8px;
    color: #a1a1aa;
}

QSpinBox, QDoubleSpinBox {
    background-color: #18181b;
    border: 1px solid #27272a;
    border-radius: 8px;
    padding: 8px 10px;
    color: #f4f4f5;
}

QSpinBox::up-button, QDoubleSpinBox::up-button, QSpinBox::down-button, QDoubleSpinBox::down-button {
    background-color: transparent;
    border: none;
}

/* History Sidebar Styling */
QListWidget#HistoryList {
    background-color: #09090b;
    border: 1px solid #27272a;
    border-radius: 14px;
    padding: 10px;
    outline: none;
}

QListWidget#HistoryList::item {
    padding: 14px;
    border-radius: 10px;
    margin-bottom: 6px;
    color: #a1a1aa;
    background-color: transparent;
}

QListWidget#HistoryList::item:hover {
    background-color: #18181b;
    color: #f4f4f5;
}

QListWidget#HistoryList::item:selected {
    background-color: #18181b;
    color: #3b82f6;
    font-weight: bold;
    border-left: 4px solid #3b82f6;
}

QPushButton#NewChatBtn {
    background-color: #18181b;
    color: #f4f4f5;
    border: 1px dashed #3f3f46;
    border-radius: 12px;
    padding: 12px;
    margin-bottom: 16px;
    font-weight: 600;
}

QPushButton#NewChatBtn:hover {
    background-color: #27272a;
    border: 1px dashed #3b82f6;
    color: #60a5fa;
}
